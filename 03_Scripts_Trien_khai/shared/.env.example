# ==============================================================================
# VIHAND GRADE - MẪU BIẾN MÔI TRƯỜNG DÀNH CHO TRẠM BIÊN (RPI4 & JETSON NANO)
# Copy file này thành .env.local trong thư mục gốc project trước khi chạy:
#   cp 03_Scripts_Trien_khai/shared/.env.example .env.local
# ==============================================================================

# 1. DATABASE SQLITE
# Đường dẫn tuyệt đối đến file vihand.db trên Linux/Debian/Ubuntu
DATABASE_URL="file:/home/pi/vihand-grade/prisma/vihand.db"

# 2. PYTHON AI SERVICE (ViT5 + YOLOv8 + Qwen SLM + Edge-TTS)
# Mặc định chạy local trên cổng 8000
VIT5_SERVICE_URL="http://localhost:8000"

# 3. GOOGLE GEMINI API KEYS (Dự phòng cho OCR đề thi & fallback khi AI trạm biên quá tải)
# Hệ thống hỗ trợ nhiều keys cách nhau bằng dấu phẩy để tự động xoay vòng ngẫu nhiên
GEMINI_API_KEYS="key_1,key_2"
# Hoặc 1 key duy nhất:
GEMINI_API_KEY="your_api_key"

# 4. CẤU HÌNH AI MICROSERVICE ENGINE (Dành cho python_service/main.py)
# Bật (1) hoặc tắt (0) Qwen2.5-0.5B-Instruct SLM (Khuyến nghị bật trên Pi4 4GB/8GB và Jetson 4GB)
ENABLE_QWEN_SLM=1
QWEN_MODEL_ID="Qwen/Qwen2.5-0.5B-Instruct"

# Đường dẫn file trọng số YOLOv8 phát hiện từ viết tay (mặc định lấy theo repo)
# YOLO_WEIGHTS_PATH="/home/pi/vihand-grade/Test_train_29_12/ver2/runs/detect/train/weights/best.pt"

# Số luồng ViT5 inference (1 là tối ưu CPU để tránh tranh chấp nhân và tràn RAM)
VIT5_WORKERS=1

# 5. CỔNG MẠNG CHO NEXT.JS WEBAPP
PORT=3000
NODE_ENV=production
